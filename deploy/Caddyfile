{
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	@documentUpload {
		method POST
		path /api/documents
	}
	request_body @documentUpload {
		max_size 6MiB
	}
	@otherRequests {
		not {
			method POST
			path /api/documents
		}
	}
	request_body @otherRequests {
		max_size 64KiB
	}
	reverse_proxy app:8765 {
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
	}
}

# Container-only liveness port; not published by Compose.
:8080 {
	respond /healthz "ok" 200
}
