{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://pilot.localhost:443 {
	tls internal
	encode zstd gzip
	@documentUpload {
		method POST
		path /api/documents
	}
	request_body @documentUpload {
		max_size 6MiB
	}
	@otherRequests {
		not {
			method POST
			path /api/documents
		}
	}
	request_body @otherRequests {
		max_size 64KiB
	}
	reverse_proxy app:8765 {
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Proto
	}
}

# Liveness is container-only and never published on the host.
:8080 {
	respond /healthz "ok" 200
}
