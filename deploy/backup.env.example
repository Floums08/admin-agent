# Protected root-owned file: chmod600. One repository/password per client.
# This is parsed by systemd EnvironmentFile; never commit the completed file.
CLIENT_ID=acme
CLIENT_CONFIG=/opt/admin-agent/runtime/acme/client.json
CLIENT_DB=/opt/admin-agent/runtime/acme/data/admin-agent.sqlite3
PYTHON=/opt/admin-agent/.venv/bin/python
APP_DIR=/opt/admin-agent
RESTIC_REPOSITORY=s3:https://YOUR-ENDPOINT/YOUR-BUCKET/acme
RESTIC_PASSWORD_FILE=/opt/admin-agent/runtime/acme/secrets/restic_password
RESTIC_CACHE_DIR=/var/cache/admin-agent-acme/restic
# Staging MUST be tmpfs (plaintext DB exists only for duration of backup).
BACKUP_STAGING_ROOT=/run/admin-agent-backup-acme
BACKUP_STATUS_FILE=/opt/admin-agent/runtime/acme/evidence/backup-status.json
# Provider-specific scoped credentials when using S3 (use your real provider):
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
